</div>

<style is:global>
  @media (pointer: fine) {
    html.has-custom-cursor,
    html.has-custom-cursor * {
      cursor: none !important;
    }
  }
</style>

<style>
  .custom-cursor {
    display: none;
  }

  @media (pointer: fine) {
    .custom-cursor {
      /* Override UA popover centering so we can track the pointer */
      display: block;
      position: fixed;
      inset: unset;
      top: 0;
      left: 0;
      width: 80px;
      height: 80px;
      margin: -40px 0 0 -40px;
      padding: 0;
      border-radius: 50%;
      border: var(--border-w) solid currentColor;
      background: var(--white);
      color: var(--ink);
      pointer-events: none;
      /* Within the top layer, stay above modal dialogs */
      z-index: 2147483647;
      opacity: 0;
      transform: translate3d(-100px, -100px, 0);
      will-change: transform;
      overflow: visible;
    }

    .custom-cursor:popover-open {
      display: block;
    }

    .custom-cursor.is-visible {
      opacity: 1;
    }

    .custom-cursor__eye {
      position: absolute;
      inset: 0;
      display: block;
      width: 72px;
      height: 72px;
      margin: auto;
      overflow: visible;
      pointer-events: none;
      opacity: 0;
      color: currentColor;
      transform-origin: center center;
    }

    .custom-cursor__eye .eye-ball {
      will-change: transform;
    }

    /* Contour strokes share the cursor ring: currentColor + --border-w (2px). */
    .custom-cursor__eye .eye-stroke,
    .custom-cursor__eye .eye-texture {
      stroke: currentColor;
    }

    .custom-cursor__eye .eye-stroke--inset,
    .custom-cursor__eye .eye-texture {
      fill: none;
    }

    .custom-cursor__eye .eye-stroke {
      stroke-width: var(--border-w);
      vector-effect: non-scaling-stroke;
    }

    /* Masks keep the inner half of a centered stroke, so 4px paints as 2px. */
    .custom-cursor__eye .eye-stroke--inset {
      stroke-width: calc(var(--border-w) * 2);
    }

    .custom-cursor__eye .eye-iris {
      fill: var(--lime);
    }

    .custom-cursor__eye .eye-pupil {
      fill: currentColor;
    }

    .custom-cursor__eye .eye-glint {
      fill: var(--white);
    }

    .custom-cursor.is-hover .custom-cursor__eye {
      opacity: 1;
      animation: cursor-blink 3.2s ease-in-out infinite;
    }
  }

  @keyframes cursor-blink {
    0%,
    72%,
    100% {
      transform: scaleY(1);
    }

    76% {
      transform: scaleY(0.06);
    }

    80% {
      transform: scaleY(1);
    }
  }

  @media (pointer: fine) and (prefers-reduced-motion: reduce) {
    .custom-cursor {
      transition: none;
    }

    .custom-cursor.is-hover .custom-cursor__eye {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const cursor = document.querySelector("[data-custom-cursor]");
  const eyeBall = document.querySelector("[data-eye-ball]");
  const finePointer = window.matchMedia("(pointer: fine)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const hoverTarget =
    "a[href], button, summary, label, [role='button'], [role='link'], [data-open-project], [data-detail-close]";

  /** ViewBox units: horizontal travel is larger than vertical. */
  const LOOK_MAX_X = 34;
  const LOOK_MAX_Y = 18;
  /** Pointer distance (px) that maps to full look travel. */
  const LOOK_REF_PX = 140;
  const LOOK_EASE = 0.2;

  const resolveInteractive = (target: EventTarget | null) => {
    if (!(target instanceof Element)) return null;
    const el = target.closest(hoverTarget);
    if (!(el instanceof HTMLElement)) return null;
    if ("disabled" in el && Boolean((el as HTMLButtonElement).disabled)) return null;
    if (el.getAttribute("aria-disabled") === "true") return null;
    return el;
  };

  const resolveAimTarget = (interactive: HTMLElement) => {
    const cell = interactive.closest(".cell");
    if (cell instanceof HTMLElement) {
      const media = cell.querySelector(".cell__media");
      if (media instanceof HTMLElement) return media;
    }
    return interactive;
  };

  const clampLook = (dx: number, dy: number) => {
    const nx = dx / LOOK_REF_PX;
    const ny = dy / LOOK_REF_PX;
    const len = Math.hypot(nx, ny);
    if (len <= 1 || len === 0) {
      return { x: nx * LOOK_MAX_X, y: ny * LOOK_MAX_Y };
    }
    const scale = 1 / len;
    return { x: nx * scale * LOOK_MAX_X, y: ny * scale * LOOK_MAX_Y };
  };

  if (cursor instanceof HTMLElement && finePointer.matches) {
    root.classList.add("has-custom-cursor");

    let x = -100;
    let y = -100;
    let lookX = 0;
    let lookY = 0;
    let targetLookX = 0;
    let targetLookY = 0;
    let raf = 0;

    const promote = () => {
      // Modal <dialog> lives in the browser top layer. A normal fixed
      // element (even at z-index 9999) cannot paint above it. Popover
      // puts the cursor in that same layer; re-showing after a dialog
      // opens moves it to the top of the top-layer stack.
      if (typeof cursor.showPopover !== "function") return;
      try {
        if (cursor.matches(":popover-open")) cursor.hidePopover();
        cursor.showPopover();
      } catch {
        // Element may be disconnected during Astro page transitions.
      }
    };

    const applyLook = () => {
      if (!(eyeBall instanceof SVGGElement)) return;
      eyeBall.setAttribute("transform", `translate(${lookX} ${lookY})`);
    };

    const render = () => {
      cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      if (reducedMotion.matches) {
        lookX = targetLookX;
        lookY = targetLookY;
      } else {
        lookX += (targetLookX - lookX) * LOOK_EASE;
        lookY += (targetLookY - lookY) * LOOK_EASE;
      }
      applyLook();

      const settling =
        Math.abs(targetLookX - lookX) > 0.05 || Math.abs(targetLookY - lookY) > 0.05;
      raf = settling ? requestAnimationFrame(render) : 0;
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    const setLookFromPointer = (
      pointerX: number,
      pointerY: number,
      interactive: HTMLElement | null,
    ) => {
      if (!interactive) {
        targetLookX = 0;
        targetLookY = 0;
        return;
      }
      const aim = resolveAimTarget(interactive);
      const rect = aim.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const next = clampLook(cx - pointerX, cy - pointerY);
      targetLookX = next.x;
      targetLookY = next.y;
    };

    const onMove = (event: PointerEvent) => {
      x = event.clientX;
      y = event.clientY;
      const interactive = resolveInteractive(event.target);
      cursor.classList.add("is-visible");
      cursor.classList.toggle("is-hover", Boolean(interactive));
      setLookFromPointer(event.clientX, event.clientY, interactive);
      schedule();
    };

    const onLeave = () => {
      cursor.classList.remove("is-visible", "is-hover");
      targetLookX = 0;
      targetLookY = 0;
      schedule();
    };

    promote();
    applyLook();

    // After any modal dialog opens, re-enter the top layer above it.
    document.addEventListener(
      "toggle",
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLDialogElement)) return;
        if (!target.open) return;
        requestAnimationFrame(promote);
      },
      true,
    );

    // Also watch detail-open: showModal() runs right after the class is
    // added, so double-rAF runs once the dialog is in the top layer.
    new MutationObserver(() => {
      if (!root.classList.contains("detail-open")) return;
      requestAnimationFrame(() => requestAnimationFrame(promote));
    }).observe(root, { attributes: true, attributeFilter: ["class"] });

    window.addEventListener("pointermove", onMove, { passive: true });
    document.addEventListener("mouseleave", onLeave);
  }
</script>
