---
---

<div
  class="custom-cursor"
  aria-hidden="true"
  data-custom-cursor
  popover="manual"
>
  <svg
    class="custom-cursor__eye"
    viewBox="0 0 380 380"
    width="72"
    height="72"
    fill="none"
    aria-hidden="true"
  >
    <path
      class="eye-stroke"
      d="M190.5 99C234.96 99 275.261 109.159 304.481 125.636C333.671 142.095 352 164.989 352 190.5C352 216.011 333.671 238.905 304.481 255.364C275.261 271.841 234.96 282 190.5 282C146.04 282 105.739 271.841 76.5186 255.364C47.3288 238.905 29 216.011 29 190.5C29 164.989 47.3288 142.095 76.5186 125.636C105.739 109.159 146.04 99 190.5 99Z"
