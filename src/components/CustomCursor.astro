    <g class="eye-ball" data-eye-ball mask="url(#eye-opening)">
      <use class="eye-iris" href="#eye-iris-shape"></use>
      <mask id="eye-iris-stroke" fill="white">
        <use href="#eye-iris-shape"></use>
