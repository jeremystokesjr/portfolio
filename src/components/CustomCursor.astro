      <path
        id="eye-iris-shape"
        d="M190 128C225.346 128 254 155.982 254 190.5C254 225.018 225.346 253 190 253C154.654 253 126 225.018 126 190.5C126 155.982 154.654 128 190 128Z"
      ></path>
      <path
        id="eye-pupil-shape"
        d="M190 153C211.039 153 228.095 169.789 228.095 190.5C228.095 211.211 211.039 228 190 228C168.96 228 151.904 211.211 151.904 190.5C151.904 169.789 168.96 153 190 153Z"
      ></path>
