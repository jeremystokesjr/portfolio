            d="M0 0C16.0273 0 16.0273 30.8239 32.0545 30.8239C48.0818 30.8239 48.0818 0 64.1091 0C80.1364 0 80.1364 30.8239 96.1636 30.8239C112.191 30.8239 112.191 0 128.218 0C144.245 0 144.245 30.8239 160.273 30.8239C176.3 30.8239 176.3 0 192.327 0C208.355 0 208.355 30.8239 224.382 30.8239C240.409 30.8239 240.409 0 256.436 0C272.464 0 272.464 30.8239 288.491 30.8239C304.518 30.8239 304.518 0 320.545 0C336.573 0 336.573 30.8239 352.6 30.8239C368.627 30.8239 368.627 0 384.655 0C400.682 0 400.682 30.8239 416.709 30.8239C432.736 30.8239 432.736 0 448.764 0C464.791 0 464.791 30.8239 480.818 30.8239C496.845 30.8239 496.845 0 512.873 0C528.9 0 528.9 30.8239 544.927 30.8239C560.955 30.8239 560.955 0 576.982 0C593.009 0 593.009 30.8239 609.036 30.8239C625.064 30.8239 625.064 0 641.091 0C657.118 0 657.118 30.8239 673.145 30.8239C689.173 30.8239 689.173 0 705.2 0"
