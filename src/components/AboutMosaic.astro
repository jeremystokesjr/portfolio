---
import { aboutTiles } from "../data/about";

/** Desktop mosaic: 3 rows with specific widths — image 690, quote 344 */
const rows = [
  aboutTiles.slice(0, 3),
  aboutTiles.slice(3, 6),
  aboutTiles.slice(6, 9),
];
---

<section class="about band" aria-label="About me">
  {
    rows.map((row, rowIndex) => (
      <div class:list={["about__row", `about__row--${rowIndex + 1}`]}>
        {row.map((tile) =>
          tile.type === "image" ? (
            <figure class:list={["tile", "tile--image", `tile--${tile.id}`]}>
              <img
                src={tile.image}
                alt={tile.imageAlt}
                width="690"
                height="600"
                loading="lazy"
              />
              <div class="tile__duotone" aria-hidden="true" />
            </figure>
          ) : (
            <article
              class:list={["tile", "tile--quote", `tile--${tile.id}`]}
              tabindex="0"
              data-quote-tile
            >
              <div class="tile__under">
                <p class="tile__context">{tile.context}</p>
              </div>
              <div class="tile__cover">
                <div class="tile__cover-face">
                  <p class="tile__quote">{tile.quote}</p>
                  <p class="tile__attr">{tile.attribution}</p>
                </div>
                <div class="tile__cover-back" aria-hidden="true" />
              </div>
            </article>
          ),
        )}
      </div>
    ))
  }
</section>

<script>
  function initQuoteTiles() {
    const tiles = document.querySelectorAll("[data-quote-tile]");
    if (!tiles.length) return;

    const coarse = window.matchMedia("(hover: none), (pointer: coarse)").matches;

    tiles.forEach((tile) => {
      if (!(tile instanceof HTMLElement)) return;
      if (tile.dataset.bound === "1") return;
      tile.dataset.bound = "1";

      if (!coarse) return;

      tile.addEventListener("click", (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLElement)) return;
        const open = target.classList.toggle("is-open");
        target.setAttribute("aria-expanded", open ? "true" : "false");
      });

      tile.setAttribute("aria-expanded", "false");
    });
  }

  initQuoteTiles();
  document.addEventListener("astro:page-load", initQuoteTiles);
</script>

<style>
  .about {
    width: 100%;
    border-bottom: none;
  }

  .about__row {
    display: grid;
    grid-template-columns: 690fr 344fr 344fr;
    min-height: clamp(320px, 42vw, 600px);
    border-bottom: var(--border);
  }

  .about__row--2 {
    grid-template-columns: 344fr 690fr 344fr;
  }

  .about__row--3 {
    grid-template-columns: 344fr 344fr 690fr;
  }

  .tile {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-right: var(--border);
    min-height: inherit;
  }

  .tile:last-child {
    border-right: none;
  }

  .tile--image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    position: absolute;
    inset: 0;
    transition: filter 0.45s ease;
  }

  .tile__duotone {
    position: absolute;
    inset: -10%;
    background: var(--ink);
    mix-blend-mode: color;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  .tile--image:hover img,
  .tile--image:focus-within img {
    filter: grayscale(0);
  }

  .tile--image:hover .tile__duotone,
  .tile--image:focus-within .tile__duotone {
    opacity: 0;
  }

  /* —— Quote tiles: cover curls up to reveal context (Figma 11:10892) —— */
  .tile--quote {
    background: var(--ink);
    perspective: 1400px;
    outline: none;
  }

  .tile__under {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    padding: clamp(1.25rem, 2.1vw, 1.8125rem);
    background: var(--ink);
  }

  .tile__context {
    margin: 0;
    max-width: 18rem;
    font-family: var(--font-text);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(1.25rem, 2.6vw, 2.25rem); /* 36px */
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--lime);
    white-space: pre-wrap;
  }

  .tile__cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    transform-origin: 50% 0%;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }

  .tile__cover-face,
  .tile__cover-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .tile__cover-face {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: clamp(1.25rem, 2vw, 2.5rem) clamp(1.25rem, 2vw, 2rem);
    background: var(--lime);
    border-right: inherit;
  }

  .tile__cover-back {
    background: linear-gradient(
      180deg,
      #1a1a1a 0%,
      #0a0a0a 45%,
      #151515 100%
    );
    transform: rotateX(180deg);
    box-shadow: inset 0 -24px 48px rgba(0, 0, 0, 0.45);
  }

  .tile__cover-back::after {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 28%;
    background: linear-gradient(
      180deg,
      rgba(198, 235, 9, 0.12),
      transparent
    );
    pointer-events: none;
  }

  .tile--quote:hover .tile__cover,
  .tile--quote:focus-visible .tile__cover,
  .tile--quote.is-open .tile__cover {
    transform: perspective(1400px) rotateX(-105deg);
  }

  .tile--quote:focus-visible {
    box-shadow: inset 0 0 0 3px var(--ink), inset 0 0 0 5px var(--lime);
  }

  .tile__quote {
    margin: 0;
    font-family: var(--font-text-cilati);
    font-style: normal;
    font-weight: 500;
    font-size: var(--text-quote);
    line-height: 1;
    letter-spacing: 0;
  }

  .tile__attr {
    margin: 0;
    font-family: var(--font-text-cilati);
    font-style: normal;
    font-weight: 500;
    font-size: var(--text-subquote);
    line-height: 1.4;
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile--image img,
    .tile__duotone,
    .tile__cover {
      transition: none;
    }

    .tile--quote:hover .tile__cover,
    .tile--quote:focus-visible .tile__cover,
    .tile--quote.is-open .tile__cover {
      transform: none;
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (max-width: 900px) {
    .about__row,
    .about__row--2,
    .about__row--3 {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .tile {
      border-right: none;
      border-bottom: var(--border);
      min-height: 280px;
    }

    .tile:last-child {
      border-bottom: var(--border);
    }

    .about__row:last-child .tile:last-child {
      border-bottom: none;
    }

    .tile--image {
      aspect-ratio: 690 / 520;
      min-height: 240px;
    }

    .tile--quote {
      min-height: 320px;
    }
  }
</style>
