---
interface Props {
  items: readonly string[];
  label?: string;
  variant?: "lime" | "ink";
  /** When true, exposes a single accessible h1 from the first item */
  heading?: boolean;
}

const { items, label = "Section", variant = "lime", heading = false } =
  Astro.props;

/**
 * One phrase per banner, repeated enough to fill wide screens.
 * Spacing between repeats is handled in CSS (100pt).
 */
const phrase = items[0] ?? "";
const copies = Array.from({ length: 8 }, () => phrase);
const headingText = items.join(" ").replace(/\u00A0/g, " ");
---

<section
  class:list={["marquee", "band", `marquee--${variant}`]}
  aria-label={label}
  data-marquee
>
  {heading && <h1 class="visually-hidden">{headingText}</h1>}
  <div class="marquee__viewport">
    <div class="marquee__track" data-marquee-track>
      <div class="marquee__group" data-marquee-group>
        {
          copies.map((item) => (
            <span class="marquee__item">{item}</span>
          ))
        }
      </div>
      <div class="marquee__group" data-marquee-group aria-hidden="true">
        {
          copies.map((item) => (
            <span class="marquee__item">{item}</span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function syncMarquee(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    const track = root.querySelector("[data-marquee-track]");
    const group = root.querySelector("[data-marquee-group]");
    if (!(track instanceof HTMLElement) || !(group instanceof HTMLElement)) return;

    const width = group.getBoundingClientRect().width;
    if (!width) return;

    // Pixel distance avoids subpixel -50% seams that look like a hard cutoff.
    track.style.setProperty("--marquee-distance", `${width}px`);
    // Keep speed roughly stable across phrase lengths (~80px/s).
    track.style.setProperty("--marquee-duration", `${Math.max(28, width / 80)}s`);
  }

  function syncAll() {
    document.querySelectorAll("[data-marquee]").forEach(syncMarquee);
  }

  const ready = () => {
    if (document.fonts?.ready) {
      document.fonts.ready.then(syncAll).catch(syncAll);
    } else {
      syncAll();
    }
  };

  ready();
  document.addEventListener("astro:page-load", ready);
  window.addEventListener("resize", syncAll);
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .marquee {
    /* Height must stay ahead of --text-banner. The old 12vw/208px band was
       shorter than the type on mid-wide screens, so Cilati ascenders and
       descenders clipped against overflow:hidden. */
    --marquee-size: var(--text-banner);
    position: relative;
    min-height: calc(var(--marquee-size) * 1.35);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .marquee--lime {
    background: var(--lime);
    color: var(--ink);
  }

  .marquee--ink {
    background: var(--ink);
    color: var(--lime);
    border-bottom: none;
  }

  .marquee__viewport {
    width: 100%;
    overflow: hidden;
  }

  .marquee__track {
    --marquee-distance: 50%;
    --marquee-duration: 45s;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: max-content;
    will-change: transform;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
  }

  .marquee__group {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    flex-shrink: 0;
  }

  .marquee__item {
    display: inline-block;
    flex: 0 0 auto;
    margin: 0;
    /* Side padding absorbs Cilati italic overhang between repeats. */
    padding-left: 0.1em;
    /* 100pt space after each string (Figma), plus overhang room */
    padding-right: calc(100pt + 0.1em);
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 900;
    font-size: var(--marquee-size);
    /* Extra leading keeps italic glyph ink inside the band. */
    line-height: 1.35;
    letter-spacing: 0;
    white-space: nowrap;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--marquee-distance)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
